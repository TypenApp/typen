<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened Runtime entitlements for a Developer ID (notarised) build.
      AutoCorrect is a PyInstaller bundle: the embedded CPython loads .so
      extension modules and uses ctypes, so unsigned-memory / library
      validation relaxations are required for it to start at all.
      The app is deliberately NOT sandboxed: a global CGEventTap and
      CGEventPost are incompatible with the App Sandbox.
    -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Not needed: we never JIT. Keep explicit so reviewers see it was considered. -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <!-- Outbound HTTPS for licence activation, update manifests and BYOK AI providers. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
