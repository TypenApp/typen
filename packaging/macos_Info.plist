<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Typen</string>
    <key>CFBundleExecutable</key>
    <string>typen</string>
    <key>CFBundleIdentifier</key>
    <string>io.autocorrect.desktop</string>
    <key>CFBundleName</key>
    <string>Typen</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>autocorrect.icns</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0.0</string>
    <key>CFBundleVersion</key>
    <string>2.0.0</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <!-- Agent app: menu-bar/tray only, no Dock icon. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- TCC usage strings: required for the Input Monitoring and Accessibility prompts. -->
    <key>NSInputMonitoringUsageDescription</key>
    <string>Typen watches the keys you type so it can spot misspellings as you finish each word. Nothing is sent anywhere; everything runs on this Mac.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>Typen uses Accessibility to replace a misspelled word in place, and to recognise password fields so it never touches them.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Typen may ask the frontmost application for its name to apply your per-app correction profiles.</string>
    <key>NSHumanReadableCopyright</key>
    <string>© Omnii. MIT licence.</string>
</dict>
</plist>
