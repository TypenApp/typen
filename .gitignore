# Local secrets / per-machine configuration
.env
.env.*
!.env.example
site/.env*
!site/.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/

# External corpus cache (re-downloaded by pipeline/external_sources.py); the README
# carries the source licences and attribution and is versioned.
pipeline/data/external/*
!pipeline/data/external/README.md

# Packaging intermediates (packaging/build_*_beta.*; regenerated by packaging/make_icon.py)
dist/
packaging/autocorrect.ico
packaging/autocorrect.icns
packaging/icons/

# Code-signing material must never live in the repo
*.p12
*.pfx
*.pem
*.cer
*.mobileprovision
*.minisign.key
site/tsconfig.tsbuildinfo

# Site
site/node_modules/
site/.next/
site/out/
site/api/_vendor/

# Release binaries live on GitHub Releases, never in git
site/public/downloads/
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.pkg

.vercel/
.env*

