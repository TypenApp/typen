# The CLI uses this file instead of .gitignore when it is present.
# Keep the site, the engine, and the lexicon. Leave installers, caches, and secrets out.

.env
.env.*
!.env.example
site/.env*
!site/.env.example

__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

pipeline/data/external/*
!pipeline/data/external/README.md

dist/
packaging/autocorrect.ico
packaging/autocorrect.icns
packaging/icons/
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.pkg
*.p12
*.pfx
*.pem
*.cer
*.mobileprovision
*.minisign.key

site/node_modules/
site/.next/
site/out/
site/api/_vendor/
site/tsconfig.tsbuildinfo
site/public/downloads/

.vercel/
