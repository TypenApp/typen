# Development-only. Copy to `.env` at the repo root. Frozen builds never read it.

# Override the embedded Ed25519 root *public* key (hex, 64 chars) when testing
# against a staging licence server. Leave empty to use the production key in
# src/autocorrect/licensing/root_key.py.
AUTOCORRECT_ROOT_PUBLIC_KEY_HEX=

# Website demo in `next dev` only: the local `autocorrect-sandbox --no-browser`
# that /api/demo is proxied to. In production the engine runs as a Vercel
# Python function (site/api/demo.py) and this is not used.
AUTOCORRECT_ENGINE_URL=http://127.0.0.1:8765

# Creator / lifetime licences are NOT configured here. Issue a signed
# certificate with the offline root private key instead:
#   python -m pipeline.issue_licence --print-device-hash
#   python -m pipeline.issue_licence --creator --device-hash <hash> --out entitlement.lic
# and copy it to <data_dir>/licence/entitlement.lic.
