# Copy to `.env` (repo root, next to the exe, or in the data dir) and fill in.

# Comma-separated SHA-256 device-id hashes that receive a perpetual Pro
# "creator" entitlement. Print your own with:
#   python -c "from autocorrect.licensing.activation_manager import compute_local_device_id_hash as h; print(h())"
AUTOCORRECT_CREATOR_DEVICE_HASHES=
AUTOCORRECT_CREATOR_NAME=Creator

# Website demo: Python engine the Next.js /api/engine proxy forwards to.
AUTOCORRECT_ENGINE_URL=http://127.0.0.1:8765
